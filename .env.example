# Copy to .env and paste in the values shared with you privately.
# Sandbox only. Never commit .env.

# Sandbox secret key. Server only.
CKO_SECRET_KEY=
# Sandbox public key. Sent to the browser for Flow.
CKO_PUBLIC_KEY=
# First 8 characters of the client ID, without cli_
CKO_SUBDOMAIN=
# Processing channel ID, starts with pc_
CKO_PROCESSING_CHANNEL_ID=
# Signs and checks the simulated webhooks. Any random local value,
# for example from: openssl rand -hex 32. Never a Checkout.com key.
CKO_WEBHOOK_SIGNATURE_KEY=

# These defaults work as they are.
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
SIMULATE_WEBHOOKS=true
SIMULATED_WEBHOOK_DELAY_MS=800
